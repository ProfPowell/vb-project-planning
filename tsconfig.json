{
  // Type-checks the shipped JavaScript from its JSDoc annotations.
  // Not used for emitting: esbuild builds dist/. Run with `npm run typecheck`.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "strict": false,
    "noUnusedLocals": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.js"]
}
